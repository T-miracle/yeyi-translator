{
  "manifest_version": 3,
  "name": "页译 · 整页 AI 翻译",
  "version": "1.3.6",
  "description": "用自己的 DeepSeek / OpenAI Key 翻译网页。支持替换译文、段落双语、动态内容及恢复原文。",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "unlimitedStorage", "activeTab", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "action": {
    "default_title": "页译 · 翻译此页",
    "default_popup": "pages/Popup/index.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "options_page": "pages/Options/index.html",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/index.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
